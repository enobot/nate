<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MovieTheater.Api</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The React client lives in ../../client and builds into wwwroot. -->
    <ClientRoot>$(MSBuildProjectDirectory)\..\..\client\</ClientRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <!-- Local runtime data (SQLite file, data protection keys) is never published or committed. -->
    <Content Remove="App_Data\**" />
    <None Remove="App_Data\**" />
    <!-- The development settings hold the local demo admin password; never ship them. -->
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <!--
    One-command demo: `dotnet run` builds the React client into wwwroot the first time,
    if it has not been built yet. This hooks the SDK's ComputeRunArguments target, so it
    only runs for `dotnet run` (not for `dotnet build` or `dotnet test`).
    Pass -p:SkipClientBuild=true to turn it off.
  -->
  <Target Name="BuildClientBeforeRun"
          BeforeTargets="ComputeRunArguments"
          Condition="'$(SkipClientBuild)' != 'true' And !Exists('$(MSBuildProjectDirectory)\wwwroot\index.html') And Exists('$(ClientRoot)package.json')">
    <Message Importance="high" Text="wwwroot/index.html not found. Building the React client (first run only)..." />
    <Exec Command="npm ci" WorkingDirectory="$(ClientRoot)" Condition="!Exists('$(ClientRoot)node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(ClientRoot)" />
  </Target>

</Project>
