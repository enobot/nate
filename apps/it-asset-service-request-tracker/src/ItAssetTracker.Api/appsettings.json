{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=App_Data/it-asset-tracker.db"
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Demo": {
    "SeedOnStartup": true,
    "EnableResetEndpoint": false
  },
  "RateLimiting": {
    "WritesPerMinute": 60
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
